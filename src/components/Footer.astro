---
// src/components/Footer.astro
import LanguagePicker from "./LanguagePicker.astro";
import { getLangFromUrl, useTranslations, useTranslatedPath } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---

<footer class="bg-canvas border-t border-hairline py-16 px-6">
  <div
    class="max-w-[1200px] mx-auto grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-8"
  >
    <!-- Col 1: Brand Info -->
    <div class="space-y-4 col-span-2 sm:col-span-3 lg:col-span-1">
      <div class="flex items-center gap-2">
        <img
          src="https://res.cloudinary.com/dyo3ckrjq/image/upload/v1782469077/logo_folw2r.png"
          alt="Zcompressor Logo"
          class="w-6 h-6 rounded-sm select-none"
        />
        <span
          class="font-sans font-semibold text-base text-ink tracking-[-0.4px]"
          >Zcompressor</span
        >
      </div>
      <p class="text-caption text-body">
        {t("footer.tagline")}
      </p>
    </div>

    <!-- Col 2: Product -->
    <div>
      <h4
        class="text-caption-mono font-mono text-mute uppercase tracking-wider mb-4"
      >
        {t("footer.product")}
      </h4>
      <ul class="space-y-2">
        <li>
          <a
            href={translatePath("/compress-pdf")}
            class="text-body-sm text-body hover:text-ink transition-colors"
            >{t("nav.compressPdf")}</a
          >
        </li>
        <li>
          <a
            href="/blog"
            class="text-body-sm text-body hover:text-ink transition-colors"
            >{t("nav.blog")}</a
          >
        </li>
        <li>
          <a
            href="/#features"
            class="text-body-sm text-body hover:text-ink transition-colors"
            >Features</a
          >
        </li>
        <li>
          <a
            href="/#faq"
            class="text-body-sm text-body hover:text-ink transition-colors"
            >{t("nav.faq")}</a
          >
        </li>
      </ul>
    </div>

    <!-- Col 2.5: Compare -->
    <div>
      <h4
        class="text-caption-mono font-mono text-mute uppercase tracking-wider mb-4"
      >
        {t("footer.compare")}
      </h4>
      <ul class="space-y-2">
        <li>
          <a
            href="/vs"
            class="text-body-sm text-body hover:text-ink transition-colors"
            >All Comparisons</a
          >
        </li>
        <li>
          <a
            href="/vs/ilovepdf"
            class="text-body-sm text-body hover:text-ink transition-colors"
            >vs iLovePDF</a
          >
        </li>
        <li>
          <a
            href="/vs/smallpdf"
            class="text-body-sm text-body hover:text-ink transition-colors"
            >vs Smallpdf</a
          >
        </li>
        <li>
          <a
            href="/vs/adobe-acrobat"
            class="text-body-sm text-body hover:text-ink transition-colors"
            >vs Adobe Acrobat</a
          >
        </li>
        <li>
          <a
            href="/vs/sejda"
            class="text-body-sm text-body hover:text-ink transition-colors"
            >vs Sejda</a
          >
        </li>
      </ul>
    </div>

    <!-- Col 3: Company & Languages -->
    <div>
      <h4
        class="text-caption-mono font-mono text-mute uppercase tracking-wider mb-4"
      >
        {t("footer.languages")}
      </h4>
      <LanguagePicker variant="footer" class="mb-3" />
      <ul class="space-y-2">
        <li>
          <a
            href="/hi/"
            class="text-body-sm text-body hover:text-ink transition-colors flex items-center gap-1.5"
            ><span class="w-1.5 h-1.5 rounded-full bg-cyan-deep"></span> Hinglish Home</a
          >
        </li>
        <li>
          <a
            href="/hi/compress-pdf"
            class="text-body-sm text-body hover:text-ink transition-colors flex items-center gap-1.5"
            ><span class="w-1.5 h-1.5 rounded-full bg-cyan-deep"></span> PDF Compressor (HI)</a
          >
        </li>
        <li>
          <a
            href="/hi/compress-pdf-for-upsc"
            class="text-body-sm text-body hover:text-ink transition-colors"
            >UPSC PDF (Hinglish)</a
          >
        </li>
        <li>
          <a
            href="/hi/compress-pdf-for-nsp-scholarship"
            class="text-body-sm text-body hover:text-ink transition-colors"
            >NSP Scholarship (Hinglish)</a
          >
        </li>
        <li>
          <hr class="border-hairline/40 my-2" />
        </li>
        <li>
          <a
            href="/about"
            class="text-body-sm text-body hover:text-ink transition-colors"
            >{t("nav.about")}</a
          >
        </li>
        <li>
          <a
            href="/contact"
            class="text-body-sm text-body hover:text-ink transition-colors"
            >{t("nav.contact")}</a
          >
        </li>
      </ul>
    </div>

    <!-- Col 4: Popular Tools -->
    <div>
      <h4
        class="text-caption-mono font-mono text-mute uppercase tracking-wider mb-4"
      >
        {t("footer.popularTools")}
      </h4>
      <ul class="space-y-2">
        <li>
          <a
            href="/compress-pdf-for-nsp-scholarship"
            class="text-body-sm text-body hover:text-ink transition-colors"
            >NSP Scholarship PDF</a
          >
        </li>
        <li>
          <a
            href="/compress-pdf-for-josaa-jee-counseling"
            class="text-body-sm text-body hover:text-ink transition-colors"
            >JoSAA JEE Counseling</a
          >
        </li>
        <li>
          <a
            href="/compress-pdf-for-upsc"
            class="text-body-sm text-body hover:text-ink transition-colors"
            >UPSC PDF Tool</a
          >
        </li>
        <li>
          <a
            href="/batch-compress-pdf"
            class="text-body-sm text-body hover:text-ink transition-colors"
            >Batch Compress PDFs</a
          >
        </li>
        <li>
          <a
            href="/compress-pdf-for-resume"
            class="text-body-sm text-body hover:text-ink transition-colors"
            >Resume PDF Tool</a
          >
        </li>
        <li>
          <hr class="border-hairline/40 my-2" />
        </li>
        <li>
          <a
            href="/compress-pdf-to-200kb"
            class="text-body-sm text-body hover:text-ink transition-colors"
            >Compress to 200 KB</a
          >
        </li>
        <li>
          <a
            href="/compress-pdf-to-300kb"
            class="text-body-sm text-body hover:text-ink transition-colors"
            >Compress to 300 KB</a
          >
        </li>
        <li>
          <a
            href="/reduce-pdf-file-size"
            class="text-body-sm text-body hover:text-ink transition-colors"
            >Reduce PDF Size</a
          >
        </li>
      </ul>
    </div>

    <!-- Col 5: Security -->
    <div>
      <h4
        class="text-caption-mono font-mono text-mute uppercase tracking-wider mb-4"
      >
        {t("footer.security")}
      </h4>
      <ul class="space-y-2">
        <li>
          <span class="text-body-sm text-body flex items-center gap-1.5"
            ><i class="fa-solid fa-lock text-xs text-cyan-deep"></i> {t("footer.localSandbox")}</span
          >
        </li>
        <li>
          <span class="text-body-sm text-body flex items-center gap-1.5"
            ><i class="fa-solid fa-network-wired text-xs text-mute"></i> {t("footer.noTelemetry")}</span
          >
        </li>
      </ul>
    </div>
  </div>

  <!-- Bottom Copyright Bar -->
  <div
    class="max-w-[1200px] mx-auto mt-12 pt-8 border-t border-hairline/60 flex flex-col sm:flex-row justify-between items-center gap-4"
  >
    <span class="text-caption text-mute">
      © 2026 Zcompressor. {t("footer.rights")}
    </span>
    <div class="flex gap-4">
      <a
        href="/terms"
        class="text-caption text-mute hover:text-ink transition-colors"
        >{t("footer.terms")}</a
      >
      <a
        href="/privacy"
        class="text-caption text-mute hover:text-ink transition-colors"
        >{t("footer.privacy")}</a
      >
    </div>
  </div>
</footer>
