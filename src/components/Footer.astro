---
// src/components/Footer.astro
---

<footer class="bg-canvas border-t border-hairline py-16 px-6">
  <div
    class="max-w-[1200px] mx-auto grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-8"
  >
    <!-- Col 1: Brand Info -->
    <div class="space-y-4 col-span-2 sm:col-span-3 lg:col-span-1">
      <div class="flex items-center gap-2">
        <img
          src="https://res.cloudinary.com/dyo3ckrjq/image/upload/v1782469077/logo_folw2r.png"
          alt="Zcompressor Logo"
          class="w-6 h-6 rounded-sm select-none"
        />
        <span
          class="font-sans font-semibold text-base text-ink tracking-[-0.4px]"
          >Zcompressor</span
        >
      </div>
      <p class="text-caption text-body">
        A premium, high-security developer-grade utility to compress PDFs
        locally in your browser.
      </p>
    </div>

    <!-- Col 2: Product -->
    <div>
      <h4
        class="text-caption-mono font-mono text-mute uppercase tracking-wider mb-4"
      >
        Product
      </h4>
      <ul class="space-y-2">
        <li>
          <a
            href="/compress-pdf"
            class="text-body-sm text-body hover:text-ink transition-colors"
            >Compressor</a
          >
        </li>
        <li>
          <a
            href="/blog"
            class="text-body-sm text-body hover:text-ink transition-colors"
            >Engineering Blog</a
          >
        </li>
        <li>
          <a
            href="/#features"
            class="text-body-sm text-body hover:text-ink transition-colors"
            >Features</a
          >
        </li>
        <li>
          <a
            href="/#faq"
            class="text-body-sm text-body hover:text-ink transition-colors"
            >FAQ</a
          >
        </li>
      </ul>
    </div>

    <!-- Col 2.5: Compare -->
    <div>
      <h4
        class="text-caption-mono font-mono text-mute uppercase tracking-wider mb-4"
      >
        Compare
      </h4>
      <ul class="space-y-2">
        <li>
          <a
            href="/vs"
            class="text-body-sm text-body hover:text-ink transition-colors"
            >All Comparisons</a
          >
        </li>
        <li>
          <a
            href="/vs/ilovepdf"
            class="text-body-sm text-body hover:text-ink transition-colors"
            >vs iLovePDF</a
          >
        </li>
        <li>
          <a
            href="/vs/smallpdf"
            class="text-body-sm text-body hover:text-ink transition-colors"
            >vs Smallpdf</a
          >
        </li>
        <li>
          <a
            href="/vs/adobe-acrobat"
            class="text-body-sm text-body hover:text-ink transition-colors"
            >vs Adobe Acrobat</a
          >
        </li>
        <li>
          <a
            href="/vs/sejda"
            class="text-body-sm text-body hover:text-ink transition-colors"
            >vs Sejda</a
          >
        </li>
      </ul>
    </div>

    <!-- Col 3: Company & Languages -->
    <div>
      <h4
        class="text-caption-mono font-mono text-mute uppercase tracking-wider mb-4"
      >
        Languages
      </h4>
      <ul class="space-y-2">
        <li>
          <a
            href="/hi/compress-pdf-for-nsp-scholarship"
            class="text-body-sm text-body hover:text-ink transition-colors"
            >NSP Scholarship (Hindi)</a
          >
        </li>
        <li>
          <a
            href="/hi/compress-pdf-for-upsc"
            class="text-body-sm text-body hover:text-ink transition-colors"
            >UPSC PDF Tool (Hindi)</a
          >
        </li>
        <li>
          <hr class="border-hairline/40 my-2" />
        </li>
        <li>
          <a
            href="/about"
            class="text-body-sm text-body hover:text-ink transition-colors"
            >About Us</a
          >
        </li>
        <li>
          <a
            href="/contact"
            class="text-body-sm text-body hover:text-ink transition-colors"
            >Contact Us</a
          >
        </li>
      </ul>
    </div>

    <!-- Col 4: Popular Tools -->
    <div>
      <h4
        class="text-caption-mono font-mono text-mute uppercase tracking-wider mb-4"
      >
        Popular Tools
      </h4>
      <ul class="space-y-2">
        <li>
          <a
            href="/compress-pdf-for-nsp-scholarship"
            class="text-body-sm text-body hover:text-ink transition-colors"
            >NSP Scholarship PDF</a
          >
        </li>
        <li>
          <a
            href="/compress-pdf-for-josaa-jee-counseling"
            class="text-body-sm text-body hover:text-ink transition-colors"
            >JoSAA JEE Counseling</a
          >
        </li>
        <li>
          <a
            href="/compress-pdf-for-upsc"
            class="text-body-sm text-body hover:text-ink transition-colors"
            >UPSC PDF Tool</a
          >
        </li>
        <li>
          <a
            href="/batch-compress-pdf"
            class="text-body-sm text-body hover:text-ink transition-colors"
            >Batch Compress PDFs</a
          >
        </li>
        <li>
          <a
            href="/compress-pdf-for-resume"
            class="text-body-sm text-body hover:text-ink transition-colors"
            >Resume PDF Tool</a
          >
        </li>
        <li>
          <hr class="border-hairline/40 my-2" />
        </li>
        <li>
          <a
            href="/compress-pdf-to-200kb"
            class="text-body-sm text-body hover:text-ink transition-colors"
            >Compress to 200 KB</a
          >
        </li>
        <li>
          <a
            href="/compress-pdf-to-300kb"
            class="text-body-sm text-body hover:text-ink transition-colors"
            >Compress to 300 KB</a
          >
        </li>
        <li>
          <a
            href="/reduce-pdf-file-size"
            class="text-body-sm text-body hover:text-ink transition-colors"
            >Reduce PDF Size</a
          >
        </li>
      </ul>
    </div>

    <!-- Col 5: Security -->
    <div>
      <h4
        class="text-caption-mono font-mono text-mute uppercase tracking-wider mb-4"
      >
        Security
      </h4>
      <ul class="space-y-2">
        <li>
          <span class="text-body-sm text-body flex items-center gap-1.5"
            ><i class="fa-solid fa-lock text-xs text-cyan-deep"></i> 100% Local Sandbox</span
          >
        </li>
        <li>
          <span class="text-body-sm text-body flex items-center gap-1.5"
            ><i class="fa-solid fa-network-wired text-xs text-mute"></i> No telemetry
            / logs sent</span
          >
        </li>
      </ul>
    </div>
  </div>

  <!-- Bottom Copyright Bar -->
  <div
    class="max-w-[1200px] mx-auto mt-12 pt-8 border-t border-hairline/60 flex flex-col sm:flex-row justify-between items-center gap-4"
  >
    <span class="text-caption text-mute">
      © 2026 Zcompressor. All rights reserved. GNS
    </span>
    <div class="flex gap-4">
      <a
        href="/terms"
        class="text-caption text-mute hover:text-ink transition-colors"
        >Terms & Conditions</a
      >
      <a
        href="/privacy"
        class="text-caption text-mute hover:text-ink transition-colors"
        >Privacy Policy</a
      >
    </div>
  </div>
</footer>
