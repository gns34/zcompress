---
// src/components/Header.astro
---

<!-- Navigation Bar -->
<nav
  class="sticky top-0 z-50 border-b border-hairline bg-canvas/80 backdrop-blur-md px-6 py-2 transition-all"
>
  <div
    class="max-w-[1200px] mx-auto h-[48px] flex items-center justify-between"
  >
    <!-- Logo -->
    <a
      href="/"
      class="flex items-center gap-2 group rounded focus-visible:ring-2 focus-visible:ring-primary focus-visible:outline-none"
      aria-label="Zcompressor Homepage"
    >
      <img
        src="https://res.cloudinary.com/dyo3ckrjq/image/upload/v1782469077/logo_folw2r.png"
        alt="Zcompressor Logo"
        class="w-8 h-8 rounded-sm select-none group-hover:scale-105 transition-transform duration-200"
      />
      <span class="font-sans font-semibold text-lg text-ink tracking-[-0.6px]"
        >Zcompressor</span
      >
    </a>

    <!-- Navigation Links -->
    <div class="hidden md:flex items-center gap-6">
      <a
        href="/compress-pdf"
        class="text-body-sm text-body hover:text-ink transition-colors px-3 py-1.5 rounded-full hover:bg-canvas-soft-2/50 focus-visible:ring-2 focus-visible:ring-primary focus-visible:outline-none"
        >Compress PDF</a
      >
      <a
        href="/blog"
        class="text-body-sm text-body hover:text-ink transition-colors px-3 py-1.5 rounded-full hover:bg-canvas-soft-2/50 focus-visible:ring-2 focus-visible:ring-primary focus-visible:outline-none"
        >Blog</a
      >

      <!-- Alternatives Dropdown -->
      <div class="relative group" id="compare-dropdown-container">
        <button
          id="compare-menu-trigger"
          class="flex items-center gap-1 text-body-sm text-body hover:text-ink transition-colors px-3 py-1.5 rounded-full hover:bg-canvas-soft-2/50 focus-visible:ring-2 focus-visible:ring-primary focus-visible:outline-none cursor-pointer"
          aria-expanded="false"
          aria-haspopup="true"
          aria-controls="compare-dropdown-menu"
        >
          <span>Alternatives</span>
          <i class="fa-solid fa-chevron-down text-[9px] transition-transform duration-200 group-hover:rotate-180" id="compare-menu-chevron" aria-hidden="true"></i>
        </button>
        <!-- Dropdown Menu -->
        <div
          id="compare-dropdown-menu"
          class="absolute left-1/2 -translate-x-1/2 top-full mt-2 w-[440px] bg-canvas border border-hairline rounded-md shadow-level-4 opacity-0 invisible group-hover:opacity-100 group-hover:visible focus-within:opacity-100 focus-within:visible transition-all duration-200 z-50 pointer-events-none group-hover:pointer-events-auto focus-within:pointer-events-auto"
          role="menu"
        >
          <div class="p-4 grid grid-cols-2 gap-2 bg-canvas rounded-t-md">
            <a
              href="/vs/ilovepdf"
              class="flex flex-col p-2.5 rounded-md hover:bg-canvas-soft-2/70 transition-colors group/item focus-visible:ring-2 focus-visible:ring-primary focus-visible:outline-none"
              role="menuitem"
            >
              <span class="flex items-center gap-2 text-body-sm-strong text-ink">
                <span class="w-1.5 h-1.5 rounded-full bg-cyan-deep"></span>
                vs. iLovePDF
              </span>
              <span class="text-[11px] text-mute mt-0.5 leading-normal">Privacy & limits comparison</span>
            </a>
            <a
              href="/vs/smallpdf"
              class="flex flex-col p-2.5 rounded-md hover:bg-canvas-soft-2/70 transition-colors group/item focus-visible:ring-2 focus-visible:ring-primary focus-visible:outline-none"
              role="menuitem"
            >
              <span class="flex items-center gap-2 text-body-sm-strong text-ink">
                <span class="w-1.5 h-1.5 rounded-full bg-violet"></span>
                vs. Smallpdf
              </span>
              <span class="text-[11px] text-mute mt-0.5 leading-normal">Limits & pricing comparison</span>
            </a>
            <a
              href="/vs/adobe-acrobat"
              class="flex flex-col p-2.5 rounded-md hover:bg-canvas-soft-2/70 transition-colors group/item focus-visible:ring-2 focus-visible:ring-primary focus-visible:outline-none"
              role="menuitem"
            >
              <span class="flex items-center gap-2 text-body-sm-strong text-ink">
                <span class="w-1.5 h-1.5 rounded-full bg-warning-deep"></span>
                vs. Adobe Acrobat
              </span>
              <span class="text-[11px] text-mute mt-0.5 leading-normal">Local vs. cloud performance</span>
            </a>
            <a
              href="/vs/pdf2go"
              class="flex flex-col p-2.5 rounded-md hover:bg-canvas-soft-2/70 transition-colors group/item focus-visible:ring-2 focus-visible:ring-primary focus-visible:outline-none"
              role="menuitem"
            >
              <span class="flex items-center gap-2 text-body-sm-strong text-ink">
                <span class="w-1.5 h-1.5 rounded-full bg-success"></span>
                vs. PDF2Go
              </span>
              <span class="text-[11px] text-mute mt-0.5 leading-normal">Ad density & security analysis</span>
            </a>
            <a
              href="/vs/sejda"
              class="flex flex-col p-2.5 rounded-md hover:bg-canvas-soft-2/70 transition-colors group/item focus-visible:ring-2 focus-visible:ring-primary focus-visible:outline-none"
              role="menuitem"
            >
              <span class="flex items-center gap-2 text-body-sm-strong text-ink">
                <span class="w-1.5 h-1.5 rounded-full bg-violet-deep"></span>
                vs. Sejda
              </span>
              <span class="text-[11px] text-mute mt-0.5 leading-normal">Quotas & server policies</span>
            </a>
            <a
              href="/vs/pdfcandy"
              class="flex flex-col p-2.5 rounded-md hover:bg-canvas-soft-2/70 transition-colors group/item focus-visible:ring-2 focus-visible:ring-primary focus-visible:outline-none"
              role="menuitem"
            >
              <span class="flex items-center gap-2 text-body-sm-strong text-ink">
                <span class="w-1.5 h-1.5 rounded-full bg-highlight-pink"></span>
                vs. PDF Candy
              </span>
              <span class="text-[11px] text-mute mt-0.5 leading-normal">Batch processing benchmarks</span>
            </a>
          </div>
          <div class="border-t border-hairline bg-canvas-soft p-3 rounded-b-md">
            <a
              href="/vs"
              class="flex items-center justify-between text-body-sm-strong text-link-deep dark:text-cyan-deep hover:underline focus-visible:outline-none"
            >
              <span>View All Product Comparisons</span>
              <i class="fa-solid fa-arrow-right text-xs"></i>
            </a>
          </div>
        </div>
      </div>

      <a
        href="/#faq"
        class="text-body-sm text-body hover:text-ink transition-colors px-3 py-1.5 rounded-full hover:bg-canvas-soft-2/50 focus-visible:ring-2 focus-visible:ring-primary focus-visible:outline-none"
        >FAQ</a
      >
      <a
        href="/about"
        class="text-body-sm text-body hover:text-ink transition-colors px-3 py-1.5 rounded-full hover:bg-canvas-soft-2/50 focus-visible:ring-2 focus-visible:ring-primary focus-visible:outline-none"
        >About Us</a
      >
      <a
        href="/contact"
        class="text-body-sm text-body hover:text-ink transition-colors px-3 py-1.5 rounded-full hover:bg-canvas-soft-2/50 focus-visible:ring-2 focus-visible:ring-primary focus-visible:outline-none"
        >Contact Us</a
      >
    </div>

    <!-- Action Button -->
    <div class="flex items-center gap-3">
      <span
        class="hidden sm:inline-flex items-center gap-1.5 px-2.5 py-1 text-[11px] font-mono border border-hairline rounded bg-canvas-soft text-body"
      >
        <span
          class="w-1.5 h-1.5 rounded-full bg-cyan animate-pulse"
          aria-hidden="true"></span>
        100% Client-Side
      </span>

      <!-- Theme Toggle Button -->
      <button
        id="theme-toggle"
        class="w-[28px] h-[28px] rounded-sm border border-hairline bg-canvas text-ink flex items-center justify-center hover:bg-canvas-soft-2/50 cursor-pointer transition-colors shadow-level-1 focus-visible:ring-2 focus-visible:ring-primary focus-visible:outline-none"
        aria-label="Toggle theme"
      >
        <i
          class="fa-regular fa-sun hidden dark:block text-xs"
          aria-hidden="true"></i>
        <i
          class="fa-regular fa-moon block dark:hidden text-xs"
          aria-hidden="true"></i>
      </button>

      <a
        href="/compress-pdf"
        class="px-3.5 h-[28px] bg-primary text-on-primary text-body-sm-strong rounded-sm hover:bg-black transition-colors inline-flex items-center justify-center select-none shadow-level-1 focus-visible:ring-2 focus-visible:ring-primary focus-visible:outline-none"
      >
        Start Compressing
      </a>
      <button
        id="mobile-menu-btn"
        class="md:hidden p-1.5 text-body hover:text-ink transition-colors rounded focus-visible:ring-2 focus-visible:ring-primary focus-visible:outline-none"
        aria-label="Toggle Navigation Menu"
      >
        <i class="fa-solid fa-bars text-xl" aria-hidden="true"></i>
      </button>
    </div>
  </div>

  <!-- Mobile Menu Dropdown -->
  <div
    id="mobile-menu"
    class="hidden md:hidden border-t border-hairline mt-2 py-4 flex flex-col gap-3 animate-fade-in"
  >
    <a
      href="/compress-pdf"
      class="mobile-nav-link text-body hover:text-ink transition-colors py-2 border-b border-hairline/30 text-body-sm-strong focus-visible:ring-2 focus-visible:ring-primary focus-visible:outline-none"
      >Compress PDF</a
    >
    <div class="border-b border-hairline/30 py-1">
      <button
        id="mobile-compare-btn"
        class="w-full flex items-center justify-between text-body hover:text-ink text-body-sm-strong py-2 text-left focus-visible:outline-none cursor-pointer"
        aria-expanded="false"
      >
        <span>Compare Alternatives</span>
        <i class="fa-solid fa-chevron-down text-xs transition-transform duration-200" id="mobile-compare-chevron"></i>
      </button>
      <div id="mobile-compare-menu" class="hidden pl-4 py-2 flex flex-col gap-2.5">
        <a href="/vs/ilovepdf" class="mobile-nav-link text-body-sm hover:text-ink flex items-center gap-2 transition-colors">
          <span class="w-1.5 h-1.5 rounded-full bg-cyan-deep"></span> vs. iLovePDF
        </a>
        <a href="/vs/smallpdf" class="mobile-nav-link text-body-sm hover:text-ink flex items-center gap-2 transition-colors">
          <span class="w-1.5 h-1.5 rounded-full bg-violet"></span> vs. Smallpdf
        </a>
        <a href="/vs/adobe-acrobat" class="mobile-nav-link text-body-sm hover:text-ink flex items-center gap-2 transition-colors">
          <span class="w-1.5 h-1.5 rounded-full bg-warning-deep"></span> vs. Adobe Acrobat
        </a>
        <a href="/vs/pdf2go" class="mobile-nav-link text-body-sm hover:text-ink flex items-center gap-2 transition-colors">
          <span class="w-1.5 h-1.5 rounded-full bg-success"></span> vs. PDF2Go
        </a>
        <a href="/vs/sejda" class="mobile-nav-link text-body-sm hover:text-ink flex items-center gap-2 transition-colors">
          <span class="w-1.5 h-1.5 rounded-full bg-violet-deep"></span> vs. Sejda
        </a>
        <a href="/vs/pdfcandy" class="mobile-nav-link text-body-sm hover:text-ink flex items-center gap-2 transition-colors">
          <span class="w-1.5 h-1.5 rounded-full bg-highlight-pink"></span> vs. PDF Candy
        </a>
        <a href="/vs" class="mobile-nav-link text-body-sm-strong text-link-deep dark:text-cyan-deep flex items-center gap-1.5 pt-1.5 transition-colors">
          All Comparisons <i class="fa-solid fa-arrow-right text-xs"></i>
        </a>
      </div>
    </div>
    <a
      href="/#faq"
      class="mobile-nav-link text-body hover:text-ink transition-colors py-2 border-b border-hairline/30 text-body-sm-strong focus-visible:ring-2 focus-visible:ring-primary focus-visible:outline-none"
      >FAQ</a
    >
    <a
      href="/about"
      class="mobile-nav-link text-body hover:text-ink transition-colors py-2 border-b border-hairline/30 text-body-sm-strong focus-visible:ring-2 focus-visible:ring-primary focus-visible:outline-none"
      >About Us</a
    >
    <a
      href="/contact"
      class="mobile-nav-link text-body hover:text-ink transition-colors py-2 border-b border-hairline/30 text-body-sm-strong focus-visible:ring-2 focus-visible:ring-primary focus-visible:outline-none"
      >Contact Us</a
    >
    <a
      href="/privacy"
      class="mobile-nav-link text-body hover:text-ink transition-colors py-2 border-b border-hairline/30 text-body-sm-strong focus-visible:ring-2 focus-visible:ring-primary focus-visible:outline-none"
      >Privacy Policy</a
    >
    <a
      href="/terms"
      class="mobile-nav-link text-body hover:text-ink transition-colors py-2 text-body-sm-strong focus-visible:ring-2 focus-visible:ring-primary focus-visible:outline-none"
      >Terms & Conditions</a
    >
    <div
      class="flex sm:hidden items-center justify-between pt-2 border-t border-hairline/30"
    >
      <span
        class="inline-flex items-center gap-1.5 px-2.5 py-1 text-[11px] font-mono border border-hairline rounded bg-canvas-soft text-body"
      >
        <span
          class="w-1.5 h-1.5 rounded-full bg-cyan animate-pulse"
          aria-hidden="true"></span>
        100% Client-Side
      </span>
    </div>
  </div>
</nav>

<script>
  // Theme Toggle Handler
  const themeToggle = document.getElementById("theme-toggle");
  if (themeToggle) {
    themeToggle.addEventListener("click", () => {
      const isDark = document.documentElement.classList.toggle("dark");
      localStorage.setItem("theme", isDark ? "dark" : "light");
    });
  }

  // Mobile Menu Toggle
  const mobileMenuBtn = document.getElementById("mobile-menu-btn");
  const mobileMenu = document.getElementById("mobile-menu");
  if (mobileMenuBtn && mobileMenu) {
    mobileMenuBtn.addEventListener("click", () => {
      const isHidden = mobileMenu.classList.contains("hidden");
      if (isHidden) {
        mobileMenu.classList.remove("hidden");
        mobileMenuBtn.querySelector("i").className =
          "fa-solid fa-xmark text-xl";
      } else {
        mobileMenu.classList.add("hidden");
        mobileMenuBtn.querySelector("i").className = "fa-solid fa-bars text-xl";
      }
    });

    // Close mobile menu when clicking nav links
    document.querySelectorAll(".mobile-nav-link").forEach((link) => {
      link.addEventListener("click", () => {
        mobileMenu.classList.add("hidden");
        mobileMenuBtn.querySelector("i").className = "fa-solid fa-bars text-xl";
      });
    });
  }

  // Mobile Alternatives Accordion Toggle
  const mobileCompareBtn = document.getElementById("mobile-compare-btn");
  const mobileCompareMenu = document.getElementById("mobile-compare-menu");
  const mobileCompareChevron = document.getElementById("mobile-compare-chevron");
  if (mobileCompareBtn && mobileCompareMenu && mobileCompareChevron) {
    mobileCompareBtn.addEventListener("click", () => {
      const isHidden = mobileCompareMenu.classList.contains("hidden");
      if (isHidden) {
        mobileCompareMenu.classList.remove("hidden");
        mobileCompareChevron.classList.add("rotate-180");
        mobileCompareBtn.setAttribute("aria-expanded", "true");
      } else {
        mobileCompareMenu.classList.add("hidden");
        mobileCompareChevron.classList.remove("rotate-180");
        mobileCompareBtn.setAttribute("aria-expanded", "false");
      }
    });
  }

  // Desktop Dropdown Accessibility & State Handling
  const compareMenuTrigger = document.getElementById("compare-menu-trigger");
  const dropdownContainer = document.getElementById("compare-dropdown-container");

  if (compareMenuTrigger && dropdownContainer) {
    // Accessibility for mouse interactions
    dropdownContainer.addEventListener("mouseenter", () => {
      compareMenuTrigger.setAttribute("aria-expanded", "true");
    });

    dropdownContainer.addEventListener("mouseleave", () => {
      compareMenuTrigger.setAttribute("aria-expanded", "false");
    });

    // Accessibility for focus interactions
    dropdownContainer.addEventListener("focusin", () => {
      compareMenuTrigger.setAttribute("aria-expanded", "true");
    });

    dropdownContainer.addEventListener("focusout", (event) => {
      // Set short timeout to check if active element is still inside dropdown
      setTimeout(() => {
        if (!dropdownContainer.contains(document.activeElement)) {
          compareMenuTrigger.setAttribute("aria-expanded", "false");
        }
      }, 10);
    });

    // Close dropdown on Escape key
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && compareMenuTrigger.getAttribute("aria-expanded") === "true") {
        compareMenuTrigger.setAttribute("aria-expanded", "false");
        // Remove focus from elements in dropdown if focused
        if (dropdownContainer.contains(document.activeElement)) {
          compareMenuTrigger.focus();
        }
      }
    });
  }
</script>
