---
import "../styles/global.css";
import { getLangFromUrl, getHreflangLinks, type HreflangAlternate } from "../i18n/utils";
import { languageTags, type SupportedLanguage } from "../i18n/ui";

interface Props {
	title?: string;
	description?: string;
	keywords?: string;
	ogImage?: string;
	ogUrl?: string;
	ogType?: string;
	lang?: SupportedLanguage;
	customAlternates?: Record<SupportedLanguage, string>;
	hreflangs?: HreflangAlternate[];
}
const {
	title = "Free Online PDF Compressor - Zcompressor | Compress PDF Free",
	description = "Compress PDF files online for free. Zcompressor is a 100% private, client-side online PDF compressor that runs completely inside your web browser. No files uploaded to servers, no limits.",
	keywords = "pdf compressor, pdf compressor free, free pdf compressor, online pdf compressor, pdf compressor online free, free online pdf compressor",
	ogImage = "https://zcompressor.com/favicon.png",
	ogUrl = "https://zcompressor.com",
	ogType = "website",
	customAlternates,
	hreflangs,
} = Astro.props;

const detectedLang = Astro.props.lang || getLangFromUrl(Astro.url);
const htmlLang = languageTags[detectedLang] || "en";
const computedHreflangs = hreflangs || getHreflangLinks(Astro.url, "https://zcompressor.com", customAlternates);
---

<!doctype html>
<html lang={htmlLang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" sizes="any" />
		<link rel="icon" type="image/png" href="/favicon-192x192.png" sizes="192x192" />
		<link rel="icon" type="image/png" href="/favicon-48x48.png" sizes="48x48" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<link rel="icon" href="/favicon.ico" sizes="32x32 48x48" />
		<meta name="generator" content={Astro.generator} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&family=JetBrains+Mono:ital,wght@0,100..800;1,100..800&display=swap"
			rel="stylesheet"
		/>
		<link rel="preconnect" href="https://cdnjs.cloudflare.com" />
		<link
			rel="preload"
			href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
			as="style"
			onload="this.onload=null;this.rel='stylesheet'"
		/>
		<noscript>
			<link
				rel="stylesheet"
				href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
			/>
		</noscript>

		<!-- SEO Meta Tags -->
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="keywords" content={keywords} />
		<meta name="robots" content="index, follow" />
		<link rel="canonical" href={ogUrl} />
		{computedHreflangs.map((alt) => (
			<link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
		))}

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content={ogType} />
		<meta property="og:url" content={ogUrl} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:site_name" content="Zcompressor" />

		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content={ogUrl} />
		<meta property="twitter:title" content={title} />
		<meta property="twitter:description" content={description} />
		<meta property="twitter:image" content={ogImage} />

		<script is:inline>
			(function () {
				const theme =
					localStorage.getItem("theme") ||
					(window.matchMedia("(prefers-color-scheme: dark)").matches
						? "dark"
						: "light");
				if (theme === "dark") {
					document.documentElement.classList.add("dark");
				} else {
					document.documentElement.classList.remove("dark");
				}
			})();
		</script>
	</head>
	<body class="bg-canvas-soft text-ink min-h-screen antialiased">
		<slot />
	</body>
</html>
