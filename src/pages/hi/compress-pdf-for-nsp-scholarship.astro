---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
---

<Layout
  title="NSP Scholarship ke liye PDF Compress kare (200 KB se kam) — 100% Secure & Free"
  description="National Scholarship Portal (scholarships.gov.in) ke liye Aadhaar card, income certificate, aur marksheets ka PDF size 200 KB se kam kare. Direct browser me bina server upload ke."
  ogUrl="https://zcompressor.com/hi/compress-pdf-for-nsp-scholarship"
>
  <Header />

  <!-- Hero Section with Mesh Gradient -->
  <section class="relative bg-mesh-gradient overflow-hidden pt-24 pb-16 md:pt-32 md:pb-24 px-4 md:px-6 border-b border-hairline">
    <div class="absolute inset-0 bg-grid-pattern opacity-[0.35] dark:opacity-[0.25] pointer-events-none z-0"></div>
    <div class="absolute inset-0 bg-radial-spotlight pointer-events-none z-0"></div>

    <div class="max-w-[800px] mx-auto text-center relative z-10">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-canvas/60 dark:bg-canvas-soft-2/40 backdrop-blur-md border border-hairline text-ink mb-6 shadow-level-2">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-cyan-deep opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-cyan-deep"></span>
        </span>
        <span class="text-caption font-mono font-medium tracking-wider uppercase text-body">Hindi / Hinglish Version</span>
      </div>

      <h1 class="text-display-xl text-ink mb-4 text-balance">
        NSP Scholarship ke liye PDF compress kare (200 KB se kam).
      </h1>

      <p class="text-body-md text-body mb-6 max-w-[600px] mx-auto text-balance">
        National Scholarship Portal (scholarships.gov.in) par Aadhaar card, Aay Praman Patra, Marksheet aur Bank Passbook PDF 200 KB se kam me resize karein.
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/compress-pdf?target=200"
          class="px-6 h-[48px] bg-primary text-on-primary text-button-lg rounded-pill hover:bg-black transition-all inline-flex items-center justify-center shadow-level-3 hover:scale-[1.02] duration-200"
        >
          200 KB me Compress karein
        </a>
      </div>
    </div>
  </section>

  <main class="py-12 md:py-16 px-4 md:px-6 max-w-[800px] mx-auto">
    <!-- Document Specs Table -->
    <section class="mb-12">
      <h2 class="text-display-md text-ink font-semibold tracking-[-0.96px] mb-6">
        NSP Scholarship Document Upload Limits.
      </h2>
      <div class="border border-hairline rounded-lg overflow-hidden shadow-level-2 bg-canvas">
        <div class="overflow-x-auto">
          <table class="w-full border-collapse">
            <thead>
              <tr>
                <th class="bg-canvas-soft-2/50 dark:bg-canvas-soft-2 text-caption-mono font-mono text-mute uppercase px-4 py-3 text-left border-b border-hairline">Document Name</th>
                <th class="bg-canvas-soft-2/50 dark:bg-canvas-soft-2 text-caption-mono font-mono text-mute uppercase px-4 py-3 text-left border-b border-hairline">Size Limit</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td class="text-body-sm-strong text-ink px-4 py-3.5 border-b border-hairline">Aadhaar Card / Student ID</td>
                <td class="text-body-sm text-body font-mono px-4 py-3.5 border-b border-hairline">PDF, 200 KB se kam</td>
              </tr>
              <tr>
                <td class="text-body-sm-strong text-ink px-4 py-3.5 border-b border-hairline">Income Certificate (Aay Praman Patra)</td>
                <td class="text-body-sm text-body font-mono px-4 py-3.5 border-b border-hairline">PDF, 200 KB se kam</td>
              </tr>
              <tr>
                <td class="text-body-sm-strong text-ink px-4 py-3.5 border-b border-hairline">Caste / Category Certificate</td>
                <td class="text-body-sm text-body font-mono px-4 py-3.5 border-b border-hairline">PDF, 200 KB se kam</td>
              </tr>
              <tr>
                <td class="text-body-sm-strong text-ink px-4 py-3.5 border-b border-hairline">Previous Marksheet / Bonafide</td>
                <td class="text-body-sm text-body font-mono px-4 py-3.5 border-b border-hairline">PDF, 200 KB se kam</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section class="mb-12 space-y-4">
      <h2 class="text-display-md text-ink font-semibold tracking-[-0.96px]">
        NSP Portal par document upload fail kyu hota hai?
      </h2>
      <p class="text-body-md text-body leading-relaxed">
        NSP Portal par sabhi documents ka file size strictly 200 KB se kam hona chahiye. Mobile scanner apps se scan karne par file size 2 MB se 4 MB tak ho jata hai, jisse portal upload me error aa jata hai.
      </p>
      <p class="text-body-md text-body leading-relaxed">
        Zcompressor aapke documents ko browser ke andar hi 200 KB se kam kar deta hai, bina kisi server par upload kiye. Isse aapke Income Certificate aur Aadhaar card ki privacy 100% safe rehti hai.
      </p>
    </section>

    <!-- Bottom CTA -->
    <section class="border-t border-hairline pt-8 text-center">
      <h2 class="text-display-sm text-ink font-semibold mb-6">Abhi apni NSP documents compress karein.</h2>
      <a
        href="/compress-pdf?target=200"
        class="px-6 h-[48px] bg-primary text-on-primary text-button-lg rounded-pill hover:bg-black transition-all inline-flex items-center justify-center shadow-level-3"
      >
        Start Compressing
      </a>
    </section>
  </main>

  <Footer />
</Layout>
