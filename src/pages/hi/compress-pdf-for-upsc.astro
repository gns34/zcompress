---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
---

<Layout
  title="UPSC Form ke liye PDF Compress kare (20–300 KB) — 100% Safe & Free"
  description="UPSC OTR portal (upsconline.nic.in) Civil Services, NDA, CDS application ke liye Photo ID aur educational certificates PDF ko 20 KB se 300 KB ke beech compress karein."
  ogUrl="https://zcompressor.com/hi/compress-pdf-for-upsc"
>
  <Header />

  <!-- Hero Section with Mesh Gradient -->
  <section class="relative bg-mesh-gradient overflow-hidden pt-24 pb-16 md:pt-32 md:pb-24 px-4 md:px-6 border-b border-hairline">
    <div class="absolute inset-0 bg-grid-pattern opacity-[0.35] dark:opacity-[0.25] pointer-events-none z-0"></div>
    <div class="absolute inset-0 bg-radial-spotlight pointer-events-none z-0"></div>

    <div class="max-w-[800px] mx-auto text-center relative z-10">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-canvas/60 dark:bg-canvas-soft-2/40 backdrop-blur-md border border-hairline text-ink mb-6 shadow-level-2">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-cyan-deep opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-cyan-deep"></span>
        </span>
        <span class="text-caption font-mono font-medium tracking-wider uppercase text-body">Hindi / Hinglish Version</span>
      </div>

      <h1 class="text-display-xl text-ink mb-4 text-balance">
        UPSC Form ke liye PDF compress kare (20–300 KB).
      </h1>

      <p class="text-body-md text-body mb-6 max-w-[600px] mx-auto text-balance">
        UPSC OTR portal (upsconline.nic.in) ke liye Photo ID proof, Marksheet, aur Category Certificate ko 20 KB se 300 KB ke beech bilkul saaf compress karein.
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/compress-pdf?target=300"
          class="px-6 h-[48px] bg-primary text-on-primary text-button-lg rounded-pill hover:bg-black transition-all inline-flex items-center justify-center shadow-level-3 hover:scale-[1.02] duration-200"
        >
          300 KB me Compress karein
        </a>
      </div>
    </div>
  </section>

  <main class="py-12 md:py-16 px-4 md:px-6 max-w-[800px] mx-auto">
    <!-- Document Specs Table -->
    <section class="mb-12">
      <h2 class="text-display-md text-ink font-semibold tracking-[-0.96px] mb-6">
        UPSC OTR Document Upload Limits.
      </h2>
      <div class="border border-hairline rounded-lg overflow-hidden shadow-level-2 bg-canvas">
        <div class="overflow-x-auto">
          <table class="w-full border-collapse">
            <thead>
              <tr>
                <th class="bg-canvas-soft-2/50 dark:bg-canvas-soft-2 text-caption-mono font-mono text-mute uppercase px-4 py-3 text-left border-b border-hairline">Document Type</th>
                <th class="bg-canvas-soft-2/50 dark:bg-canvas-soft-2 text-caption-mono font-mono text-mute uppercase px-4 py-3 text-left border-b border-hairline">Required Range</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td class="text-body-sm-strong text-ink px-4 py-3.5 border-b border-hairline">Photo ID Card (Aadhaar / Voter / Passport)</td>
                <td class="text-body-sm text-body font-mono px-4 py-3.5 border-b border-hairline">PDF, 20 KB – 300 KB</td>
              </tr>
              <tr>
                <td class="text-body-sm-strong text-ink px-4 py-3.5 border-b border-hairline">Educational Qualification Certificate</td>
                <td class="text-body-sm text-body font-mono px-4 py-3.5 border-b border-hairline">PDF, 20 KB – 300 KB</td>
              </tr>
              <tr>
                <td class="text-body-sm-strong text-ink px-4 py-3.5 border-b border-hairline">Category / PwD Certificate</td>
                <td class="text-body-sm text-body font-mono px-4 py-3.5 border-b border-hairline">PDF, 20 KB – 300 KB</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Bottom CTA -->
    <section class="border-t border-hairline pt-8 text-center">
      <h2 class="text-display-sm text-ink font-semibold mb-6">Apna UPSC PDF abhi compress karein.</h2>
      <a
        href="/compress-pdf?target=300"
        class="px-6 h-[48px] bg-primary text-on-primary text-button-lg rounded-pill hover:bg-black transition-all inline-flex items-center justify-center shadow-level-3"
      >
        Start Compressing
      </a>
    </section>
  </main>

  <Footer />
</Layout>
