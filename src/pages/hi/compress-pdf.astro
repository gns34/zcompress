---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
---

<Layout
  title="Compress PDF Online - Zcompressor | 100% Private & Free"
  description="Zcompressor ke free online PDF compressor se PDF file size kam karein. Bina kisi server upload ke direct browser me secure, fast aur unlimited compression."
  keywords="pdf compress online, pdf compress kaise kare, online pdf size kam kare, pdf compressor 100kb, pdf compressor 200kb, free pdf compressor"
  ogUrl="https://zcompressor.com/hi/compress-pdf"
  ogType="website"
>
  <!-- JSON-LD FAQ Schema for SEO -->
  <script type="application/ld+json" is:inline>
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Zcompressor dusre online tools se alag kaise hai?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "<p>Dusre online tools jaise iLovePDF ya Smallpdf aapke documents ko unke remote servers par upload karte hain. Zcompressor 100% client-side WebAssembly use karta hai, jisse aapki files aapke device ke browser me hi compress hoti hain aur internet par kisi server par upload nahi hoti.</p>"
          }
        },
        {
          "@type": "Question",
          "name": "Kya Zcompressor par target size set kar sakte hain?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "<p>Haan! Zcompressor me aap ready-made presets jaise 250 KB, 500 KB, 1 MB chun sakte hain ya custom size slider se apna manpasand target KB set kar sakte hain.</p>"
          }
        },
        {
          "@type": "Question",
          "name": "Kya ek saath multiple PDFs compress kar sakte hain?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "<p>Haan, Zcompressor me batch processing bilkul free hai. Aap ek saath kayi PDFs upload kar sakte hain aur unhe ek click me compress karke alag-alag ya ek ZIP file me download kar sakte hain.</p>"
          }
        }
      ]
    }
  </script>

  <Header />

  <!-- Hero Section with Mesh Gradient -->
  <section
    class="relative bg-mesh-gradient overflow-hidden pt-24 pb-12 md:pt-32 md:pb-20 px-4 md:px-6 border-b border-hairline"
  >
    <!-- Background grid overlay -->
    <div
      class="absolute inset-0 bg-grid-pattern opacity-[0.35] dark:opacity-[0.25] pointer-events-none z-0"
    ></div>
    <!-- Spotlight gradient overlay -->
    <div class="absolute inset-0 bg-radial-spotlight pointer-events-none z-0"></div>

    <div class="max-w-[800px] mx-auto text-center relative z-10">
      <!-- Eyebrow Badge -->
      <div
        class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-canvas/60 dark:bg-canvas-soft-2/40 backdrop-blur-md border border-hairline text-ink mb-6 shadow-level-2"
      >
        <span class="relative flex h-2 w-2">
          <span
            class="animate-ping absolute inline-flex h-full w-full rounded-full bg-cyan-deep opacity-75"
          ></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-cyan-deep"></span>
        </span>
        <span
          class="text-caption font-mono font-medium tracking-wider uppercase text-body"
          >Client-Side Engine • Zero Server Uploads</span
        >
      </div>

      <!-- Headline -->
      <h1 class="text-display-xl text-ink mb-4 text-balance font-semibold tracking-[-2.4px]">
        Online PDF Compressor.
      </h1>

      <!-- Description -->
      <p class="text-body-md text-body mb-2 max-w-[600px] mx-auto text-balance leading-relaxed">
        Apne browser ke andar hi high-quality compression chalayein. Aapke documents kisi bhi server par nahi jaate. 100% safe, fast aur bilkul free.
      </p>
    </div>
  </section>

  <!-- Compressor Tool Dashboard -->
  <section
    id="compressor"
    class="py-12 px-4 sm:px-6 max-w-[1200px] mx-auto scroll-mt-[64px]"
  >
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <!-- Main Compressor Card -->
      <div class="lg:col-span-2 space-y-6">
        <!-- Drag & Drop Zone -->
        <div
          id="dropzone"
          class="relative group border-2 border-dashed border-hairline-strong/60 rounded-lg bg-canvas p-8 sm:p-12 text-center hover:border-primary/50 hover:bg-canvas-soft transition-all duration-300 shadow-level-3 focus-within:border-primary focus-within:ring-2 focus-within:ring-primary/20"
        >
          <input
            type="file"
            id="file-input"
            multiple
            accept=".pdf"
            class="absolute inset-0 w-full h-full opacity-0 cursor-pointer z-10 focus:outline-none"
            aria-label="Select PDF files to compress"
          />

          <div class="space-y-4">
            <div
              class="w-16 h-16 mx-auto rounded-full bg-canvas-soft border border-hairline flex items-center justify-center group-hover:scale-110 group-hover:border-primary/30 transition-all duration-300 shadow-level-2"
            >
              <i
                class="fa-regular fa-file-pdf text-3xl text-body group-hover:text-primary transition-colors"
                aria-hidden="true"
              ></i>
            </div>
            <div>
              <p class="text-body-md-strong text-ink mb-1">
                Apni PDF files yahan drag & drop karein
              </p>
              <p class="text-body-sm text-body">
                ya computer / phone se file choose karein
              </p>
            </div>
            <div
              class="pt-2 flex flex-wrap justify-center gap-3 text-caption text-mute font-mono"
            >
              <span>
                <i class="fa-solid fa-lock text-cyan-deep mr-1" aria-hidden="true"></i> 100% Local Sandbox
              </span>
              <span>•</span>
              <span>
                <i class="fa-solid fa-bolt text-warning mr-1" aria-hidden="true"></i> Instant Local Processing
              </span>
            </div>
          </div>
        </div>

        <!-- File Queue Panel -->
        <div
          id="queue-container"
          class="hidden rounded-lg bg-canvas border border-hairline p-4 sm:p-6 shadow-level-3 space-y-4 text-left"
        >
          <div class="flex items-center justify-between pb-4 border-b border-hairline">
            <div class="flex items-center gap-2">
              <h3 class="text-display-sm text-ink font-semibold tracking-[-0.6px]">
                Selected Documents
              </h3>
              <span
                id="queue-badge"
                class="px-2 py-0.5 text-caption-mono font-mono rounded bg-canvas-soft border border-hairline text-body"
              >0 files</span>
            </div>
            <button
              id="clear-queue-btn"
              class="text-body-sm text-mute hover:text-error transition-colors flex items-center gap-1 focus-visible:ring-2 focus-visible:ring-primary focus-visible:outline-none"
              aria-label="Clear all files"
            >
              <i class="fa-regular fa-trash-can text-xs" aria-hidden="true"></i>
              Clear List
            </button>
          </div>

          <!-- Queue List Items -->
          <div id="queue-list" class="space-y-3 max-h-[360px] overflow-y-auto pr-1"></div>

          <!-- Global Actions Bar -->
          <div
            class="pt-4 border-t border-hairline flex flex-col sm:flex-row items-center justify-between gap-4"
          >
            <div class="text-body-sm text-body space-y-0.5 text-center sm:text-left">
              <div>Total Original: <strong id="total-input-size" class="text-ink font-mono">0 KB</strong></div>
              <div id="total-savings-container" class="hidden text-success font-medium">
                Saved: <strong id="total-output-size" class="font-mono">0 KB</strong> (<span id="total-savings-pct">0%</span>)
              </div>
            </div>
            <div class="flex items-center gap-3 w-full sm:w-auto">
              <button
                id="compress-btn"
                class="w-full sm:w-auto px-6 h-[40px] bg-primary text-on-primary text-button-md rounded-pill hover:bg-black transition-all flex items-center justify-center gap-2 shadow-level-3 focus-visible:ring-2 focus-visible:ring-primary focus-visible:outline-none disabled:opacity-50 cursor-pointer"
              >
                <i class="fa-solid fa-compress" aria-hidden="true"></i>
                Sabhi Files Compress Karein
              </button>
              <button
                id="download-zip-btn"
                class="hidden w-full sm:w-auto px-6 h-[40px] bg-canvas text-ink border border-hairline text-button-md rounded-pill hover:bg-canvas-soft transition-all flex items-center justify-center gap-2 shadow-level-2 focus-visible:ring-2 focus-visible:ring-primary focus-visible:outline-none cursor-pointer"
              >
                <i class="fa-regular fa-file-archive" aria-hidden="true"></i>
                Download ZIP
              </button>
            </div>
          </div>
        </div>

        <!-- Terminal Output Log Panel -->
        <div
          class="rounded-lg bg-[#121212] text-[#f5f5f5] shadow-level-4 overflow-hidden border border-[#222222]"
        >
          <div
            id="terminal-header"
            class="bg-[#171717] border-b border-[#222222] px-4 py-2.5 flex items-center justify-between select-none cursor-pointer hover:bg-[#1a1a1a] transition-colors"
            role="button"
            aria-expanded="true"
            aria-controls="terminal-logs"
            tabindex="0"
          >
            <div class="flex items-center gap-2">
              <span class="w-3 h-3 rounded-full bg-error-deep" aria-hidden="true"></span>
              <span class="w-3 h-3 rounded-full bg-warning" aria-hidden="true"></span>
              <span class="w-3 h-3 rounded-full bg-cyan-deep" aria-hidden="true"></span>
              <span class="text-caption-mono text-white/50 ml-2 font-mono">Zcompressor-engine-console</span>
              <i
                id="terminal-toggle-icon"
                class="fa-solid fa-chevron-down text-white/40 text-[10px] transition-transform duration-200 ml-1"
                aria-hidden="true"
              ></i>
            </div>
            <button
              id="clear-logs-btn"
              class="text-white/60 hover:text-white transition-colors text-caption-mono font-mono flex items-center gap-1 rounded focus-visible:ring-2 focus-visible:ring-white focus-visible:outline-none cursor-pointer"
              aria-label="Clear Console Logs"
            >
              <i class="fa-solid fa-terminal text-[10px]" aria-hidden="true"></i>
              Clear
            </button>
          </div>
          <div
            id="terminal-logs"
            class="p-4 h-[180px] overflow-y-auto font-mono text-code text-left space-y-1.5 scrollbar-thin scrollbar-thumb-white/10 scrollbar-track-transparent transition-all"
          >
            <div class="text-white/40">
              [SYS] Console ready. Files select karein compress karne ke liye…
            </div>
          </div>
        </div>
      </div>

      <!-- Settings & Controls Panel -->
      <div class="space-y-6">
        <div
          class="rounded-lg bg-canvas border border-hairline p-4 sm:p-6 shadow-level-3 space-y-6 text-left"
        >
          <h3
            class="text-display-sm text-ink font-semibold tracking-[-0.6px] flex items-center gap-2 pb-4 border-b border-hairline"
          >
            <i class="fa-solid fa-sliders text-body text-base" aria-hidden="true"></i>
            Compression Settings
          </h3>

          <!-- Presets -->
          <div class="space-y-3">
            <span class="text-body-sm-strong text-ink block">Target File Size Preset</span>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-1 gap-2">
              <!-- Preset 250 KB -->
              <button
                data-preset="250kb"
                class="preset-btn text-left p-3 rounded border border-hairline hover:border-hairline-strong transition-all flex items-start justify-between group focus-visible:ring-2 focus-visible:ring-primary focus-visible:outline-none cursor-pointer"
              >
                <div>
                  <div class="text-body-sm-strong text-ink group-hover:text-primary transition-colors">
                    250 KB Target
                  </div>
                  <div class="text-caption text-body">
                    Maximum compression. Strict portal limits ke liye ideal.
                  </div>
                </div>
                <span class="px-2 py-0.5 text-[10px] font-mono border border-hairline rounded bg-canvas-soft text-body mt-0.5">250 KB</span>
              </button>

              <!-- Preset 500 KB -->
              <button
                data-preset="500kb"
                class="preset-btn text-left p-3 rounded border border-hairline hover:border-hairline-strong transition-all flex items-start justify-between group focus-visible:ring-2 focus-visible:ring-primary focus-visible:outline-none cursor-pointer"
              >
                <div>
                  <div class="text-body-sm-strong text-ink group-hover:text-primary transition-colors">
                    500 KB Target
                  </div>
                  <div class="text-caption text-body">
                    Balanced quality. College aur admissions ke liye.
                  </div>
                </div>
                <span class="px-2 py-0.5 text-[10px] font-mono border border-hairline rounded bg-canvas-soft text-body mt-0.5">500 KB</span>
              </button>

              <!-- Preset 1 MB (Default) -->
              <button
                data-preset="1mb"
                class="preset-btn active text-left p-3 rounded border-2 border-primary bg-canvas-soft-2/50 transition-all flex items-start justify-between group focus-visible:ring-2 focus-visible:ring-primary focus-visible:outline-none cursor-pointer"
              >
                <div>
                  <div class="text-body-sm-strong text-ink">
                    1 MB Target <span class="text-caption text-primary font-mono">(Recommended)</span>
                  </div>
                  <div class="text-caption text-body">
                    Job portals, email attachments aur resumes ke liye.
                  </div>
                </div>
                <span class="px-2 py-0.5 text-[10px] font-mono rounded bg-primary text-on-primary mt-0.5">1,000 KB</span>
              </button>

              <!-- Preset 2 MB -->
              <button
                data-preset="2mb"
                class="preset-btn text-left p-3 rounded border border-hairline hover:border-hairline-strong transition-all flex items-start justify-between group focus-visible:ring-2 focus-visible:ring-primary focus-visible:outline-none cursor-pointer"
              >
                <div>
                  <div class="text-body-sm-strong text-ink group-hover:text-primary transition-colors">
                    2 MB Target
                  </div>
                  <div class="text-caption text-body">
                    Highest visual clarity. Presentations aur portfolios ke liye.
                  </div>
                </div>
                <span class="px-2 py-0.5 text-[10px] font-mono border border-hairline rounded bg-canvas-soft text-body mt-0.5">2,000 KB</span>
              </button>

              <!-- Custom Size Preset -->
              <button
                data-preset="custom"
                class="preset-btn text-left p-3 rounded border border-hairline hover:border-hairline-strong transition-all flex items-start justify-between group focus-visible:ring-2 focus-visible:ring-primary focus-visible:outline-none cursor-pointer"
              >
                <div>
                  <div class="text-body-sm-strong text-ink group-hover:text-primary transition-colors">
                    Custom Target Size
                  </div>
                  <div class="text-caption text-body">
                    Apna exact target size (KB me) enter karein.
                  </div>
                </div>
                <span class="px-2 py-0.5 text-[10px] font-mono border border-hairline rounded bg-canvas-soft text-body mt-0.5">Custom</span>
              </button>
            </div>
          </div>

          <!-- Custom Sliders (Hidden by default) -->
          <div id="custom-sliders" class="hidden space-y-4 pt-4 border-t border-hairline animate-fade-in">
            <div class="space-y-2">
              <div class="flex justify-between text-body-sm">
                <label for="size-slider" class="font-medium text-ink">Target Size (KB)</label>
                <span id="size-val" class="font-mono text-primary font-bold">1000 KB</span>
              </div>
              <input
                type="range"
                id="size-slider"
                min="50"
                max="10000"
                step="50"
                value="1000"
                class="w-full accent-primary cursor-pointer"
              />
              <div class="flex justify-between text-caption text-mute font-mono">
                <span>50 KB</span>
                <span>10,000 KB (10 MB)</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Help Info Callout -->
        <div
          class="rounded p-4 bg-canvas-soft border border-hairline text-body-sm text-body space-y-2 shadow-level-1 text-left"
        >
          <div class="font-medium text-ink flex items-center gap-1.5">
            <i class="fa-solid fa-circle-info text-link" aria-hidden="true"></i>
            Visual Quality Guarantee
          </div>
          <p class="leading-relaxed">
            Ye tool smart multi-pass algorithms use karta hai taaki scanned certificates aur marksheets ke text aur signature reject na hon.
          </p>
          <p class="text-caption text-mute">
            Note: 100% privacy ke sath sabhi calculations aapke browser me hi run hoti hain.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Accordion FAQ Section -->
  <section
    id="faq"
    class="py-16 md:py-20 px-4 md:px-6 max-w-[800px] mx-auto text-left scroll-mt-[64px]"
  >
    <div class="text-center mb-12">
      <span class="text-caption-mono font-mono text-mute uppercase tracking-widest">
        Compare Brand Features
      </span>
      <h2
        class="text-display-lg text-ink font-semibold tracking-[-0.8px] md:tracking-[-1.28px] mt-2 mb-4 text-balance"
      >
        Zcompressor vs. Dusre Brands.
      </h2>
    </div>

    <!-- Accordion Items -->
    <div class="space-y-4">
      <div class="border border-hairline rounded-lg bg-canvas overflow-hidden shadow-level-2 faq-item">
        <button
          class="w-full flex items-center justify-between p-5 text-left text-body-md-strong text-ink hover:bg-canvas-soft transition-colors select-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:outline-none"
          aria-expanded="false"
        >
          <span>Zcompressor Adobe Acrobat Online se kaise behtar hai?</span>
          <i class="fa-solid fa-chevron-down text-mute text-sm transition-transform duration-200 ml-4 flex-shrink-0" aria-hidden="true"></i>
        </button>
        <div class="max-h-0 overflow-hidden transition-all duration-300 ease-in-out faq-answer">
          <div class="p-5 pt-0 text-body-sm text-body border-t border-hairline/50 mt-4 leading-relaxed">
            Zcompressor 100% free hai, bina kisi login ya registration ke chalta hai, aur aapki files kabhi bhi kisi server par upload nahi karta. Adobe Acrobat Online me 1 file ke baad sign-in maangta hai aur cloud server par documents bhejta hai.
          </div>
        </div>
      </div>

      <div class="border border-hairline rounded-lg bg-canvas overflow-hidden shadow-level-2 faq-item">
        <button
          class="w-full flex items-center justify-between p-5 text-left text-body-md-strong text-ink hover:bg-canvas-soft transition-colors select-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:outline-none"
          aria-expanded="false"
        >
          <span>Kya Smallpdf ya iLovePDF jaisa 2 file ka limit hai?</span>
          <i class="fa-solid fa-chevron-down text-mute text-sm transition-transform duration-200 ml-4 flex-shrink-0" aria-hidden="true"></i>
        </button>
        <div class="max-h-0 overflow-hidden transition-all duration-300 ease-in-out faq-answer">
          <div class="p-5 pt-0 text-body-sm text-body border-t border-hairline/50 mt-4 leading-relaxed">
            Nahi! Zcompressor par koi daily limit ya quota nahi hai. Aap jitni chahein utni files ek saath ya alag-alag compress kar sakte hain.
          </div>
        </div>
      </div>
    </div>
  </section>

  <Footer />

  <!-- Core Javascript Compression Logic -->
  <script is:inline>
    // Helper to dynamically load external scripts
    function loadScript(src) {
      return new Promise((resolve, reject) => {
        const script = document.createElement("script");
        script.src = src;
        script.async = true;
        script.onload = resolve;
        script.onerror = () => reject(new Error(`Failed to load script: ${src}`));
        document.body.appendChild(script);
      });
    }

    let librariesPromise = null;
    function loadLibraries() {
      if (librariesPromise) return librariesPromise;

      librariesPromise = Promise.all([
        loadScript("https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"),
        loadScript("https://unpkg.com/pdf-lib@1.17.1/dist/pdf-lib.min.js"),
        loadScript("https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"),
      ]).then(() => {
        if (window.pdfjsLib) {
          window.pdfjsLib.GlobalWorkerOptions.workerSrc =
            "https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js";
        }
      });
      return librariesPromise;
    }

    // Trigger background loading after page load or on first interaction
    window.addEventListener("load", () => {
      if ("requestIdleCallback" in window) {
        requestIdleCallback(() => setTimeout(loadLibraries, 1000));
      } else {
        setTimeout(loadLibraries, 1500);
      }
    });

    const triggerEvents = ["dragover", "click", "touchstart"];
    function triggerLoad() {
      loadLibraries();
      triggerEvents.forEach((evt) =>
        document.removeEventListener(evt, triggerLoad)
      );
    }
    triggerEvents.forEach((evt) =>
      document.addEventListener(evt, triggerLoad, { passive: true })
    );

    // Program State
    let queue = [];
    let isProcessing = false;
    let selectedPreset = "1mb";
    let customTargetSize = 1000; // KB

    // DOM Elements
    const dropzone = document.getElementById("dropzone");
    const fileInput = document.getElementById("file-input");
    const queueContainer = document.getElementById("queue-container");
    const queueList = document.getElementById("queue-list");
    const queueBadge = document.getElementById("queue-badge");
    const totalInputSizeEl = document.getElementById("total-input-size");
    const totalSavingsContainer = document.getElementById("total-savings-container");
    const totalOutputSizeEl = document.getElementById("total-output-size");
    const totalSavingsPctEl = document.getElementById("total-savings-pct");
    const compressBtn = document.getElementById("compress-btn");
    const downloadZipBtn = document.getElementById("download-zip-btn");
    const clearQueueBtn = document.getElementById("clear-queue-btn");
    const terminalLogs = document.getElementById("terminal-logs");
    const clearLogsBtn = document.getElementById("clear-logs-btn");
    const presetButtons = document.querySelectorAll(".preset-btn");
    const customSliders = document.getElementById("custom-sliders");
    const sizeSlider = document.getElementById("size-slider");
    const sizeVal = document.getElementById("size-val");

    // Collapsible Terminal Elements
    const terminalHeader = document.getElementById("terminal-header");
    const terminalToggleIcon = document.getElementById("terminal-toggle-icon");

    // Terminal Logger
    function logToConsole(message, type = "info") {
      const timestamp = new Date().toTimeString().split(" ")[0];
      const line = document.createElement("div");

      let prefix = "[SYS]";
      let colorClass = "text-white/70";

      if (type === "err") {
        prefix = "[ERR]";
        colorClass = "text-error-soft";
      } else if (type === "suc") {
        prefix = "[SUC]";
        colorClass = "text-cyan-deep";
      } else if (type === "warn") {
        prefix = "[WRN]";
        colorClass = "text-warning";
      }

      line.className = `${colorClass} transition-opacity duration-200`;
      line.innerHTML = `<span class="opacity-40 select-none">${timestamp}</span> <span class="font-bold">${prefix}</span> ${message}`;

      if (terminalLogs) {
        terminalLogs.appendChild(line);
        terminalLogs.scrollTop = terminalLogs.scrollHeight;
      }
    }

    if (clearLogsBtn) {
      clearLogsBtn.addEventListener("click", (e) => {
        e.stopPropagation();
        if (terminalLogs) terminalLogs.innerHTML = "";
        logToConsole("Console cleared.", "sys");
      });
    }

    if (terminalHeader) {
      terminalHeader.addEventListener("click", () => {
        const isCollapsed = terminalLogs.classList.contains("hidden");
        if (isCollapsed) {
          terminalLogs.classList.remove("hidden");
          terminalToggleIcon.classList.remove("rotate-180");
          terminalHeader.setAttribute("aria-expanded", "true");
        } else {
          terminalLogs.classList.add("hidden");
          terminalToggleIcon.classList.add("rotate-180");
          terminalHeader.setAttribute("aria-expanded", "false");
        }
      });
    }

    // Preset Selection Handlers
    presetButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        presetButtons.forEach((b) => {
          b.classList.remove("active", "border-2", "border-primary", "bg-canvas-soft-2/50");
          b.classList.add("border", "border-hairline");
          const tag = b.querySelector("span:last-child");
          if (tag && !b.classList.contains("active")) {
            tag.classList.remove("bg-primary", "text-on-primary");
            tag.classList.add("bg-canvas-soft", "text-body");
          }
        });

        btn.classList.add("active", "border-2", "border-primary", "bg-canvas-soft-2/50");
        btn.classList.remove("border", "border-hairline");
        const activeTag = btn.querySelector("span:last-child");
        if (activeTag) {
          activeTag.classList.remove("bg-canvas-soft", "text-body");
          activeTag.classList.add("bg-primary", "text-on-primary");
        }

        const preset = btn.getAttribute("data-preset");
        selectedPreset = preset;

        if (preset === "custom") {
          customSliders.classList.remove("hidden");
          customTargetSize = parseInt(sizeSlider.value, 10);
          logToConsole(`Custom size chuna gaya: ${customTargetSize} KB`, "sys");
        } else {
          customSliders.classList.add("hidden");
          if (preset === "250kb") customTargetSize = 250;
          if (preset === "500kb") customTargetSize = 500;
          if (preset === "1mb") customTargetSize = 1000;
          if (preset === "2mb") customTargetSize = 2000;
          logToConsole(`Preset chuna gaya: ${preset.toUpperCase()} (${customTargetSize} KB)`, "sys");
        }
      });
    });

    if (sizeSlider) {
      sizeSlider.addEventListener("input", (e) => {
        customTargetSize = parseInt(e.target.value, 10);
        sizeVal.textContent = `${customTargetSize.toLocaleString()} KB`;
      });
    }

    // Drag and Drop Events
    if (dropzone) {
      ["dragenter", "dragover"].forEach((eventName) => {
        dropzone.addEventListener(eventName, (e) => {
          e.preventDefault();
          e.stopPropagation();
          dropzone.classList.add("border-primary", "bg-canvas-soft");
        });
      });

      ["dragleave", "drop"].forEach((eventName) => {
        dropzone.addEventListener(eventName, (e) => {
          e.preventDefault();
          e.stopPropagation();
          dropzone.classList.remove("border-primary", "bg-canvas-soft");
        });
      });

      dropzone.addEventListener("drop", (e) => {
        const dt = e.dataTransfer;
        const files = dt.files;
        handleFiles(files);
      });
    }

    if (fileInput) {
      fileInput.addEventListener("change", (e) => {
        handleFiles(e.target.files);
        fileInput.value = "";
      });
    }

    function formatBytes(bytes, decimals = 1) {
      if (bytes === 0) return "0 Bytes";
      const k = 1024;
      const dm = decimals < 0 ? 0 : decimals;
      const sizes = ["Bytes", "KB", "MB", "GB"];
      const i = Math.floor(Math.log(bytes) / Math.log(k));
      return parseFloat((bytes / Math.pow(k, i)).toFixed(dm)) + " " + sizes[i];
    }

    function handleFiles(files) {
      const validFiles = Array.from(files).filter(
        (file) => file.type === "application/pdf" || file.name.endsWith(".pdf")
      );

      if (validFiles.length === 0) {
        logToConsole("Kewal valid PDF files hi allowed hain.", "err");
        return;
      }

      validFiles.forEach((file) => {
        const id = "pdf-" + Math.random().toString(36).substr(2, 9);
        queue.push({
          id,
          file,
          status: "pending",
          originalSize: file.size,
          compressedSize: null,
          compressedBlob: null,
          progress: 0,
        });
        logToConsole(`Queue me joda gaya: ${file.name} (${formatBytes(file.size)})`, "info");
      });

      renderQueue();
      loadLibraries();
    }

    function renderQueue() {
      if (queue.length === 0) {
        queueContainer.classList.add("hidden");
        return;
      }

      queueContainer.classList.remove("hidden");
      queueBadge.textContent = `${queue.length} file${queue.length > 1 ? "s" : ""}`;

      const totalInput = queue.reduce((acc, curr) => acc + curr.originalSize, 0);
      totalInputSizeEl.textContent = formatBytes(totalInput);

      const compressedItems = queue.filter((i) => i.status === "completed");
      if (compressedItems.length > 0) {
        const totalOutput = compressedItems.reduce((acc, curr) => acc + curr.compressedSize, 0);
        const originalSubset = compressedItems.reduce((acc, curr) => acc + curr.originalSize, 0);
        const savingsBytes = Math.max(0, originalSubset - totalOutput);
        const savingsPct = Math.round((savingsBytes / originalSubset) * 100);

        totalSavingsContainer.classList.remove("hidden");
        totalOutputSizeEl.textContent = formatBytes(totalOutput);
        totalSavingsPctEl.textContent = `${savingsPct}%`;
      } else {
        totalSavingsContainer.classList.add("hidden");
      }

      const allCompleted = queue.length > 0 && queue.every((i) => i.status === "completed");
      if (allCompleted && queue.length > 1) {
        downloadZipBtn.classList.remove("hidden");
      } else {
        downloadZipBtn.classList.add("hidden");
      }

      queueList.innerHTML = "";
      queue.forEach((item) => {
        const el = document.createElement("div");
        el.className =
          "p-3 rounded-lg border border-hairline bg-canvas-soft flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 text-body-sm transition-all";

        let statusMarkup = "";
        if (item.status === "pending") {
          statusMarkup = `<span class="text-caption font-mono text-mute">Waiting</span>`;
        } else if (item.status === "processing") {
          statusMarkup = `
            <div class="w-28 space-y-1">
              <div class="flex justify-between text-[10px] font-mono text-mute">
                <span>Compressing</span>
                <span>${item.progress}%</span>
              </div>
              <div class="w-full bg-canvas border border-hairline rounded-full h-1.5 overflow-hidden">
                <div class="bg-primary h-1.5 transition-all duration-300" style="width: ${item.progress}%"></div>
              </div>
            </div>`;
        } else if (item.status === "completed") {
          const savings = Math.max(0, item.originalSize - item.compressedSize);
          const pct = Math.round((savings / item.originalSize) * 100);
          statusMarkup = `
            <div class="flex items-center gap-3">
              <span class="text-xs font-mono text-success font-medium">-${pct}%</span>
              <button data-download="${item.id}" class="px-3 py-1 bg-primary text-on-primary text-caption rounded-sm hover:bg-black transition-colors font-medium cursor-pointer">
                Download
              </button>
            </div>`;
        } else if (item.status === "error") {
          statusMarkup = `<span class="text-caption font-mono text-error">Failed</span>`;
        }

        el.innerHTML = `
          <div class="flex items-center gap-3 overflow-hidden w-full sm:w-auto">
            <i class="fa-regular fa-file-pdf text-xl text-body flex-shrink-0" aria-hidden="true"></i>
            <div class="overflow-hidden truncate">
              <div class="font-medium text-ink truncate">${item.file.name}</div>
              <div class="text-caption text-mute font-mono">
                ${formatBytes(item.originalSize)} ${item.compressedSize ? "→ " + formatBytes(item.compressedSize) : ""}
              </div>
            </div>
          </div>
          <div class="flex items-center gap-4 w-full sm:w-auto justify-between sm:justify-end">
            ${statusMarkup}
            ${
              item.status === "pending"
                ? `<button data-remove="${item.id}" class="text-mute hover:text-error transition-colors p-1 cursor-pointer" aria-label="Remove item"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button>`
                : ""
            }
          </div>
        `;
        queueList.appendChild(el);
      });

      // Bind events inside queue
      document.querySelectorAll("[data-remove]").forEach((btn) => {
        btn.addEventListener("click", () => {
          const id = btn.getAttribute("data-remove");
          queue = queue.filter((i) => i.id !== id);
          renderQueue();
        });
      });

      document.querySelectorAll("[data-download]").forEach((btn) => {
        btn.addEventListener("click", () => {
          const id = btn.getAttribute("data-download");
          const item = queue.find((i) => i.id === id);
          if (item && item.compressedBlob) {
            downloadBlob(item.compressedBlob, item.file.name.replace(/\.pdf$/i, "-compressed.pdf"));
          }
        });
      });
    }

    function downloadBlob(blob, filename) {
      const url = URL.createObjectURL(blob);
      const a = document.createElement("a");
      a.href = url;
      a.download = filename;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
    }

    if (clearQueueBtn) {
      clearQueueBtn.addEventListener("click", () => {
        queue = [];
        renderQueue();
        logToConsole("Queue clear ki gayi.", "sys");
      });
    }

    if (compressBtn) {
      compressBtn.addEventListener("click", async () => {
        if (isProcessing || queue.length === 0) return;
        isProcessing = true;
        compressBtn.disabled = true;

        logToConsole("Compression start hui (Client-side WebAssembly)…", "sys");

        try {
          await loadLibraries();

          for (let i = 0; i < queue.length; i++) {
            const item = queue[i];
            if (item.status === "completed") continue;

            item.status = "processing";
            renderQueue();
            logToConsole(`File process ho rahi hai: ${item.file.name}`, "info");

            try {
              const fileBuffer = await item.file.arrayBuffer();
              const compressedBytes = await compressPdfDocument(
                new Uint8Array(fileBuffer),
                customTargetSize,
                (progress) => {
                  item.progress = progress;
                  renderQueue();
                }
              );

              item.compressedBlob = new Blob([compressedBytes], { type: "application/pdf" });
              item.compressedSize = item.compressedBlob.size;
              item.status = "completed";
              logToConsole(
                `Success: ${item.file.name} compress hui ${formatBytes(item.originalSize)} se ${formatBytes(item.compressedSize)} me!`,
                "suc"
              );
            } catch (err) {
              console.error(err);
              item.status = "error";
              logToConsole(`Error in ${item.file.name}: ${err.message}`, "err");
            }
            renderQueue();
          }
        } catch (err) {
          logToConsole(`Critical Engine Error: ${err.message}`, "err");
        } finally {
          isProcessing = false;
          compressBtn.disabled = false;
        }
      });
    }

    if (downloadZipBtn) {
      downloadZipBtn.addEventListener("click", async () => {
        if (!window.JSZip) return;
        const zip = new window.JSZip();
        queue.forEach((item) => {
          if (item.status === "completed" && item.compressedBlob) {
            zip.file(item.file.name.replace(/\.pdf$/i, "-compressed.pdf"), item.compressedBlob);
          }
        });
        const content = await zip.generateAsync({ type: "blob" });
        downloadBlob(content, "zcompressor-compressed-files.zip");
        logToConsole("ZIP archive download kiya gaya.", "suc");
      });
    }

    async function compressPdfDocument(originalBytes, targetKb, onProgress) {
      const pdfjsLib = window.pdfjsLib;
      const PDFLib = window.PDFLib;
      const targetBytes = targetKb * 1024;

      const loadingTask = pdfjsLib.getDocument({ data: originalBytes });
      const pdfDoc = await loadingTask.promise;
      const totalPages = pdfDoc.numPages;

      let dpi = 150;
      let quality = 0.75;

      if (targetKb <= 300) {
        dpi = 100;
        quality = 0.55;
      }

      async function runPass(dpiVal, qVal, passNum) {
        const outDoc = await PDFLib.PDFDocument.create();
        for (let pageNum = 1; pageNum <= totalPages; pageNum++) {
          const page = await pdfDoc.getPage(pageNum);
          const viewport = page.getViewport({ scale: dpiVal / 72 });

          const canvas = document.createElement("canvas");
          const ctx = canvas.getContext("2d");
          canvas.width = viewport.width;
          canvas.height = viewport.height;

          await page.render({ canvasContext: ctx, viewport }).promise;

          const imgDataUrl = canvas.toDataURL("image/jpeg", qVal);
          const imgBytes = await fetch(imgDataUrl).then((r) => r.arrayBuffer());
          const embeddedImg = await outDoc.embedJpg(imgBytes);

          const origViewport = page.getViewport({ scale: 1 });
          const outPage = outDoc.addPage([origViewport.width, origViewport.height]);
          outPage.drawImage(embeddedImg, {
            x: 0,
            y: 0,
            width: origViewport.width,
            height: origViewport.height,
          });

          onProgress(Math.round(((pageNum + (passNum - 1) * totalPages) / (totalPages * 2)) * 100));
        }
        return await outDoc.save();
      }

      let compressed = await runPass(dpi, quality, 1);
      if (compressed.length > targetBytes) {
        const factor = Math.sqrt(targetBytes / compressed.length);
        dpi = Math.max(75, Math.round(dpi * factor));
        quality = Math.max(0.3, quality * factor);
        compressed = await runPass(dpi, quality, 2);
      }

      onProgress(100);
      return compressed;
    }

    // FAQ Accordion
    document.querySelectorAll(".faq-item button").forEach((button) => {
      button.addEventListener("click", () => {
        const item = button.parentElement;
        const answer = item.querySelector(".faq-answer");
        const icon = button.querySelector("i");

        if (answer.style.maxHeight) {
          answer.style.maxHeight = null;
          icon.style.transform = "rotate(0deg)";
          button.setAttribute("aria-expanded", "false");
        } else {
          document.querySelectorAll(".faq-item button").forEach((btn) => {
            const ans = btn.parentElement.querySelector(".faq-answer");
            ans.style.maxHeight = null;
            btn.parentElement.querySelector("i").style.transform = "rotate(0deg)";
            btn.setAttribute("aria-expanded", "false");
          });
          answer.style.maxHeight = answer.scrollHeight + "px";
          icon.style.transform = "rotate(180deg)";
          button.setAttribute("aria-expanded", "true");
        }
      });
    });
  </script>
</Layout>
