    <!-- Spotlight gradient overlay -->
    <div class="absolute inset-0 bg-radial-spotlight pointer-events-none z-0">
    </div>

    <!-- Decorative glowing background orbs -->
    <div
      class="absolute top-1/4 left-1/4 w-[320px] h-[320px] rounded-full bg-cyan/10 dark:bg-cyan/5 blur-[100px] pointer-events-none z-0 animate-pulse hidden md:block"
