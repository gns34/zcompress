---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
---

<Layout
  title="Zcompressor Alternatives & Competitor Comparisons | Free Online PDF Compressor"
  description="Compare Zcompressor with iLovePDF, Smallpdf, and Adobe Acrobat. Learn why client-side, local processing is the safest way to compress PDFs online."
  ogUrl="https://zcompressor.com/vs"
>
  <Header />

  <main class="min-h-screen bg-canvas-soft text-ink py-16 px-6 relative overflow-hidden">
    <!-- Background grid & lighting -->
    <div class="absolute inset-0 bg-grid-pattern opacity-[0.25] pointer-events-none z-0"></div>
    <div class="absolute inset-0 bg-radial-spotlight pointer-events-none z-0"></div>

    <div class="max-w-[1000px] mx-auto relative z-10">
      <!-- Header -->
      <div class="text-center mb-16 max-w-[700px] mx-auto">
        <span
          class="text-caption-mono font-mono text-link-deep dark:text-cyan-deep uppercase tracking-wider block mb-3"
        >
          Product Comparisons
        </span>
        <h1
          class="text-display-lg md:text-display-xl text-ink font-semibold tracking-[-1.5px] md:tracking-[-2.4px] mb-6"
        >
          Compare Zcompressor.
        </h1>
        <p class="text-body-lg text-body text-balance">
          Most online PDF tools upload your sensitive documents to remote servers. Zcompressor does not. See how we stack up against the competition.
        </p>
      </div>

      <!-- Main Directory Cards Grid -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-16">
        <!-- iLovePDF Card -->
        <a
          href="/vs/ilovepdf"
          class="block rounded-lg bg-canvas border border-hairline p-6 shadow-level-3 hover:scale-[1.02] transition-transform duration-300 group"
          id="compare-ilovepdf-card"
        >
          <div class="flex items-center gap-2 mb-4">
            <span class="text-caption-mono font-mono text-mute">01</span>
            <span class="w-1.5 h-1.5 rounded-full bg-cyan-deep"></span>
            <span class="text-caption-mono font-mono text-body uppercase tracking-wider">iLovePDF Alternative</span>
          </div>
          <h2 class="text-display-md text-ink font-semibold tracking-[-0.96px] mb-3 group-hover:text-link transition-colors">
            Zcompressor vs. iLovePDF.
          </h2>
          <p class="text-body-sm text-body mb-6 leading-relaxed">
            Compare security standards, upload dependencies, and why client-side processing keeps documents secure.
          </p>
          <span class="text-body-sm-strong text-link-deep dark:text-cyan-deep flex items-center gap-1 group-hover:underline">
            Read Comparison <i class="fa-solid fa-arrow-right text-xs"></i>
          </span>
        </a>

        <!-- Smallpdf Card -->
        <a
          href="/vs/smallpdf"
          class="block rounded-lg bg-canvas border border-hairline p-6 shadow-level-3 hover:scale-[1.02] transition-transform duration-300 group"
          id="compare-smallpdf-card"
        >
          <div class="flex items-center gap-2 mb-4">
            <span class="text-caption-mono font-mono text-mute">02</span>
            <span class="w-1.5 h-1.5 rounded-full bg-violet"></span>
            <span class="text-caption-mono font-mono text-body uppercase tracking-wider">Smallpdf Alternative</span>
          </div>
          <h2 class="text-display-md text-ink font-semibold tracking-[-0.96px] mb-3 group-hover:text-link transition-colors">
            Zcompressor vs. Smallpdf.
          </h2>
          <p class="text-body-sm text-body mb-6 leading-relaxed">
            Compare daily limits, subscription traps, and Zcompressor's unlimited, 100% free local batch pipeline.
          </p>
          <span class="text-body-sm-strong text-link-deep dark:text-cyan-deep flex items-center gap-1 group-hover:underline">
            Read Comparison <i class="fa-solid fa-arrow-right text-xs"></i>
          </span>
        </a>

        <!-- Adobe Acrobat Card -->
        <a
          href="/vs/adobe-acrobat"
          class="block rounded-lg bg-canvas border border-hairline p-6 shadow-level-3 hover:scale-[1.02] transition-transform duration-300 group"
          id="compare-adobe-card"
        >
          <div class="flex items-center gap-2 mb-4">
            <span class="text-caption-mono font-mono text-mute">03</span>
            <span class="w-1.5 h-1.5 rounded-full bg-warning-deep"></span>
            <span class="text-caption-mono font-mono text-body uppercase tracking-wider">Adobe Alternative</span>
          </div>
          <h2 class="text-display-md text-ink font-semibold tracking-[-0.96px] mb-3 group-hover:text-link transition-colors">
            Zcompressor vs. Adobe Acrobat.
          </h2>
          <p class="text-body-sm text-body mb-6 leading-relaxed">
            Compare registration gates, installation footprints, and the performance differences of in-browser compression.
          </p>
          <span class="text-body-sm-strong text-link-deep dark:text-cyan-deep flex items-center gap-1 group-hover:underline">
            Read Comparison <i class="fa-solid fa-arrow-right text-xs"></i>
          </span>
        </a>

        <!-- PDF2Go Card -->
        <a
          href="/vs/pdf2go"
          class="block rounded-lg bg-canvas border border-hairline p-6 shadow-level-3 hover:scale-[1.02] transition-transform duration-300 group"
          id="compare-pdf2go-card"
        >
          <div class="flex items-center gap-2 mb-4">
            <span class="text-caption-mono font-mono text-mute">04</span>
            <span class="w-1.5 h-1.5 rounded-full bg-success"></span>
            <span class="text-caption-mono font-mono text-body uppercase tracking-wider">PDF2Go Alternative</span>
          </div>
          <h2 class="text-display-md text-ink font-semibold tracking-[-0.96px] mb-3 group-hover:text-link transition-colors">
            Zcompressor vs. PDF2Go.
          </h2>
          <p class="text-body-sm text-body mb-6 leading-relaxed">
            Compare ad density, layout clutter, upload dependencies, and client-side web assembly optimizations.
          </p>
          <span class="text-body-sm-strong text-link-deep dark:text-cyan-deep flex items-center gap-1 group-hover:underline">
            Read Comparison <i class="fa-solid fa-arrow-right text-xs"></i>
          </span>
        </a>

        <!-- Sejda Card -->
        <a
          href="/vs/sejda"
          class="block rounded-lg bg-canvas border border-hairline p-6 shadow-level-3 hover:scale-[1.02] transition-transform duration-300 group"
          id="compare-sejda-card"
        >
          <div class="flex items-center gap-2 mb-4">
            <span class="text-caption-mono font-mono text-mute">05</span>
            <span class="w-1.5 h-1.5 rounded-full bg-violet-deep"></span>
            <span class="text-caption-mono font-mono text-body uppercase tracking-wider">Sejda Alternative</span>
          </div>
          <h2 class="text-display-md text-ink font-semibold tracking-[-0.96px] mb-3 group-hover:text-link transition-colors">
            Zcompressor vs. Sejda.
          </h2>
          <p class="text-body-sm text-body mb-6 leading-relaxed">
            Compare page caps, task quotas, and server retention policy security concerns against our local pipeline.
          </p>
          <span class="text-body-sm-strong text-link-deep dark:text-cyan-deep flex items-center gap-1 group-hover:underline">
            Read Comparison <i class="fa-solid fa-arrow-right text-xs"></i>
          </span>
        </a>

        <!-- PDF Candy Card -->
        <a
          href="/vs/pdfcandy"
          class="block rounded-lg bg-canvas border border-hairline p-6 shadow-level-3 hover:scale-[1.02] transition-transform duration-300 group"
          id="compare-pdfcandy-card"
        >
          <div class="flex items-center gap-2 mb-4">
            <span class="text-caption-mono font-mono text-mute">06</span>
            <span class="w-1.5 h-1.5 rounded-full bg-highlight-pink"></span>
            <span class="text-caption-mono font-mono text-body uppercase tracking-wider">PDF Candy Alternative</span>
          </div>
          <h2 class="text-display-md text-ink font-semibold tracking-[-0.96px] mb-3 group-hover:text-link transition-colors">
            Zcompressor vs. PDF Candy.
          </h2>
          <p class="text-body-sm text-body mb-6 leading-relaxed">
            Compare hourly limits, layout clutter, cloud transfers, and local parallel multi-thread batch workers.
          </p>
          <span class="text-body-sm-strong text-link-deep dark:text-cyan-deep flex items-center gap-1 group-hover:underline">
            Read Comparison <i class="fa-solid fa-arrow-right text-xs"></i>
          </span>
        </a>
      </div>

      <!-- General Comparison Callout / Mesh Section -->
      <section class="rounded-lg bg-canvas border border-hairline p-8 shadow-level-4 mb-16 relative overflow-hidden">
        <div class="absolute inset-0 bg-mesh-gradient opacity-10 pointer-events-none"></div>
        <div class="max-w-[700px]">
          <h2 class="text-display-md text-ink font-semibold tracking-[-0.96px] mb-4">
            Why client-side processing wins.
          </h2>
          <p class="text-body-md text-body leading-relaxed mb-6">
            Unlike competitors who process your files on their cloud nodes, Zcompressor converts and compresses PDFs inside a local sandboxed thread in your web browser. No network uploads. No storage breaches. Just local, high-speed security.
          </p>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 pt-4 border-t border-hairline">
            <div>
              <h3 class="text-body-sm-strong text-ink flex items-center gap-1.5 mb-1">
                <i class="fa-solid fa-shield-halved text-success"></i> 100% Secure
              </h3>
              <p class="text-caption text-body">Documents stay on your local disk. Never uploaded to the cloud.</p>
            </div>
            <div>
              <h3 class="text-body-sm-strong text-ink flex items-center gap-1.5 mb-1">
                <i class="fa-solid fa-bolt text-warning-deep"></i> Zero Wait
              </h3>
              <p class="text-caption text-body">No file upload queue times. Immediate compression in RAM.</p>
            </div>
            <div>
              <h3 class="text-body-sm-strong text-ink flex items-center gap-1.5 mb-1">
                <i class="fa-solid fa-infinity text-violet-deep dark:text-violet-soft"></i> Unlimited
              </h3>
              <p class="text-caption text-body">Compress unlimited batches of PDFs for free, with no watermarks.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- CTA -->
      <div class="text-center py-8">
        <h2 class="text-display-sm text-ink font-semibold mb-6">Ready to compress your files securely?</h2>
        <a
          href="/compress-pdf"
          class="inline-flex items-center justify-center px-6 h-[48px] bg-primary text-on-primary text-button-lg rounded-pill hover:bg-black transition-all shadow-level-3 hover:scale-[1.02] duration-200"
        >
          Start Compressing Now
        </a>
      </div>
    </div>
  </main>

  <Footer />
</Layout>
